; LAB pilot C: story scene world in Godot 3D behind the original story25d characters (overlay).
config_version=5

[application]
config/name="MegaWheel Story 3D World (lab)"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
